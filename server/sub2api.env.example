# sub2api 容器时区与语言对齐示例（仅加在 sub2api 主应用容器下，不动 postgres/redis 时区）
# 在 docker-compose.yml 的 sub2api.environment 中使用：
#   - TZ=${SUB2API_TZ:-America/Los_Angeles}
#   - LANG=${SUB2API_LANG:-en_US.UTF-8}
#   - HTTP_PROXY=http://metacubexd:7890
#   - HTTPS_PROXY=http://metacubexd:7890
#   - NO_PROXY=localhost,127.0.0.1,postgres,redis,sub2api,.local

SUB2API_TZ=America/Los_Angeles
SUB2API_LANG=en_US.UTF-8
